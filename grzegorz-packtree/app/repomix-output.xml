import { Router } from 'express';
import Trip from '../models/Trip.js';
import Plan from '../models/Plan.js';

const router = Router();

// GET /api/trips — list all trips (with resolved plan names)
router.get('/', async (_req, res) => {
  try {
    const trips = await Trip.find()
      .populate('planIds', 'name description status')
      .sort({ updatedAt: -1 });
    res.json(trips);
  } catch (err) { res.status(500).json({ error: err.message }); }
});

// GET /api/trips/:id — full trip with all plan trees
router.get('/:id', async (req, res) => {
  try {
    const trip = await Trip.findById(req.params.id)
      .populate('planIds'); // full plan documents
    if (!trip) return res.status(404).json({ error: 'Not found' });
    res.json(trip);
  } catch (err) { res.status(500).json({ error: err.message }); }
});

// POST /api/trips — create trip
router.post('/', async (req, res) => {
  try {
    const { name, description = '', planIds = [] } = req.body;
    if (!name) return res.status(400).json({ error: 'name required' });
    res.status(201).json(await Trip.create({ name, description, planIds }));
  } catch (err) { res.status(400).json({ error: err.message }); }
});

// PATCH /api/trips/:id — update name/description/planIds order
router.patch('/:id', async (req, res) => {
  try {
    const trip = await Trip.findByIdAndUpdate(req.params.id, req.body, { new: true })
      .populate('planIds', 'name description status');
    if (!trip) return res.status(404).json({ error: 'Not found' });
    res.json(trip);
  } catch (err) { res.status(400).json({ error: err.message }); }
});

// DELETE /api/trips/:id
router.delete('/:id', async (req, res) => {
  try {
    await Trip.findByIdAndDelete(req.params.id);
    res.json({ deleted: true });
  } catch (err) { res.status(500).json({ error: err.message }); }
});

// POST /api/trips/:id/add-plan
router.post('/:id/add-plan', async (req, res) => {
  try {
    const { planId } = req.body;
    if (!planId) return res.status(400).json({ error: 'planId required' });
    const [trip, plan] = await Promise.all([Trip.findById(req.params.id), Plan.findById(planId)]);
    if (!trip || !plan) return res.status(404).json({ error: 'Not found' });
    if (!trip.planIds.map(String).includes(planId)) {
      trip.planIds.push(planId);
      await trip.save();
    }
    await trip.populate('planIds', 'name description status');
    res.json(trip);
  } catch (err) { res.status(400).json({ error: err.message }); }
});

// DELETE /api/trips/:id/remove-plan/:planId
router.delete('/:id/remove-plan/:planId', async (req, res) => {
  try {
    const trip = await Trip.findById(req.params.id);
    if (!trip) return res.status(404).json({ error: 'Not found' });
    trip.planIds = trip.planIds.filter((p) => p.toString() !== req.params.planId);
    await trip.save();
    await trip.populate('planIds', 'name description status');
    res.json(trip);
  } catch (err) { res.status(400).json({ error: err.message }); }
});

// PATCH /api/trips/:id/packing-progress
router.patch('/:id/packing-progress', async (req, res) => {
  try {
    const { progress } = req.body;
    if (typeof progress !== 'object' || !progress) return res.status(400).json({ error: 'progress required' });
    const trip = await Trip.findById(req.params.id);
    if (!trip) return res.status(404).json({ error: 'Not found' });
    trip.packingProgress = progress;
    trip.markModified('packingProgress');
    await trip.save();
    res.json({ ok: true });
  } catch (err) { res.status(400).json({ error: err.message }); }
});

export default router;
