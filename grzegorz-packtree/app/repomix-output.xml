<file path="frontend/src/utils/conflicts.ts">
import type { Plan, TreeNode } from '../types';

export interface ConflictInfo {
  /** elementId → array of plan names that contain it */
  elementConflicts: Record<string, string[]>;
  /** nodeId → plan name of the plan that "owns" this node's element first */
  nodeConflictMap: Record<string, string>;
  /** total number of conflicting elements */
  conflictCount: number;
}

/**
 * Scan all plans in a trip and find elements that appear in more than one plan.
 * Returns a map of elementId → [planName, planName, ...] for duplicates,
 * and nodeId → "conflicting plan name" for highlighting individual nodes.
 */
export function detectConflicts(plans: Plan[]): ConflictInfo {
  // First pass: map elementId → [planName, ...]
  const elementToPlanNames: Record<string, string[]> = {};

  for (const plan of plans) {
    const elemIds = collectElementIds(plan.tree);
    for (const eid of elemIds) {
      if (!elementToPlanNames[eid]) elementToPlanNames[eid] = [];
      if (!elementToPlanNames[eid].includes(plan.name)) {
        elementToPlanNames[eid].push(plan.name);
      }
    }
  }

  // Keep only conflicts (element in 2+ plans)
  const elementConflicts: Record<string, string[]> = {};
  for (const [eid, names] of Object.entries(elementToPlanNames)) {
    if (names.length > 1) elementConflicts[eid] = names;
  }

  // Second pass: map nodeId → "other plan name" (the other plan that has the same element)
  const nodeConflictMap: Record<string, string> = {};

  for (const plan of plans) {
    walkNodes(plan.tree, (node) => {
      const eid = node.elementId;
      if (elementConflicts[eid]) {
        // The "other" plans are all except this plan
        const otherPlans = elementConflicts[eid].filter((n) => n !== plan.name);
        if (otherPlans.length > 0) {
          nodeConflictMap[node._id] = otherPlans.join(', ');
        }
      }
    });
  }

  return {
    elementConflicts,
    nodeConflictMap,
    conflictCount: Object.keys(elementConflicts).length,
  };
}

function collectElementIds(nodes: TreeNode[]): string[] {
  const ids: string[] = [];
  for (const n of nodes) {
    ids.push(n.elementId);
    if (n.children?.length) ids.push(...collectElementIds(n.children));
  }
  return ids;
}

function walkNodes(nodes: TreeNode[], cb: (node: TreeNode) => void): void {
  for (const n of nodes) {
    cb(n);
    if (n.children?.length) walkNodes(n.children, cb);
  }
}
</file>

