import { useEffect, useState } from 'react';
import { useParams, Link } from 'react-router-dom';
import type { TripWithPlans, Plan, Element, TreeNode } from '../types';
import { getTrip, getItems } from '../utils/api';
import { formatWeight, calcTreeWeight } from '../utils/weight';
import { detectConflicts, type ConflictInfo } from '../utils/conflicts';

export default function TripViewPage() {
  const { id } = useParams<{ id: string }>();
  const [trip,       setTrip]       = useState<TripWithPlans | null>(null);
  const [elementMap, setElementMap] = useState<Record<string, Element>>({});
  const [loading,    setLoading]    = useState(true);
  const [error,      setError]      = useState('');

  useEffect(() => {
    Promise.all([getTrip(id!), getItems()])
      .then(([t, items]) => {
        setTrip(t);
        const map: Record<string, Element> = {};
        items.forEach((i) => { map[i._id] = i; });
        setElementMap(map);
      })
      .catch((e: Error) => setError(e.message))
      .finally(() => setLoading(false));
  }, [id]);

  if (loading) return <div style={{ padding: 40, textAlign: 'center' }}><span className="spinner" /></div>;
  if (error || !trip) return (
    <div className="page"><div style={{ color: 'var(--danger)', padding: 20 }}>{error || 'Trip not found'}</div></div>
  );

  const plans     = trip.planIds as Plan[];
  const conflicts = detectConflicts(plans);
  const totalWeight = plans.reduce((sum, plan) => sum + calcTreeWeight(plan.tree, elementMap), 0);
  const totalItems  = plans.reduce((sum, plan) => sum + countNodes(plan.tree), 0);

  return (
    <div className="page">
      <div className="page-header">
        <div>
          <Link to="/trips" style={{ fontSize: 13, color: 'var(--text3)' }}>← Trips</Link>
          <h1 className="page-title" style={{ marginTop: 4 }}>🧳 {trip.name}</h1>
          {trip.description && <div style={{ fontSize: 14, color: 'var(--text3)', marginTop: 4 }}>{trip.description}</div>}
        </div>
        <Link to={`/trips/${id}/play`} className="btn btn-primary">▶ Play trip</Link>
      </div>

      {/* Stats row */}
      <div style={{ display: 'flex', gap: 10, marginBottom: 20, flexWrap: 'wrap' }}>
        {[
          { label: 'Plans',        value: plans.length,           icon: '🗂' },
          { label: 'Total items',  value: totalItems,             icon: '📦' },
          { label: 'Total weight', value: formatWeight(totalWeight), icon: '⚖️' },
        ].map(({ label, value, icon }) => (
          <div key={label} className="card" style={{ display: 'flex', alignItems: 'center', gap: 12, minWidth: 140 }}>
            <span style={{ fontSize: 22 }}>{icon}</span>
            <div>
              <div style={{ fontSize: 18, fontWeight: 700 }}>{value}</div>
              <div style={{ fontSize: 12, color: 'var(--text3)' }}>{label}</div>
            </div>
          </div>
        ))}

        {/* Conflict count badge */}
        <div className="card" style={{ display: 'flex', alignItems: 'center', gap: 12, minWidth: 140, borderColor: conflicts.conflictCount > 0 ? 'rgba(251,191,36,0.4)' : undefined }}>
          <span style={{ fontSize: 22 }}>{conflicts.conflictCount > 0 ? '⚠️' : '✅'}</span>
          <div>
            <div style={{ fontSize: 18, fontWeight: 700, color: conflicts.conflictCount > 0 ? 'var(--warn)' : 'var(--accent)' }}>
              {conflicts.conflictCount}
            </div>
            <div style={{ fontSize: 12, color: 'var(--text3)' }}>
              {conflicts.conflictCount > 0 ? 'Conflicts' : 'No conflicts'}
            </div>
          </div>
        </div>
      </div>

      {/* Conflict summary panel */}
      {conflicts.conflictCount > 0 && (
        <ConflictPanel conflicts={conflicts} elementMap={elementMap} />
      )}

      {/* Plans */}
      {plans.length === 0 ? (
        <div className="empty-state"><div className="icon">🗂</div><div>No plans in this trip yet</div></div>
      ) : (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 20 }}>
          {plans.map((plan, i) => (
            <PlanSection
              key={plan._id}
              plan={plan}
              elementMap={elementMap}
              conflicts={conflicts}
              index={i}
            />
          ))}
        </div>
      )}
    </div>
  );
}

// ── Conflict panel ─────────────────────────────────────────────────────────────

function ConflictPanel({ conflicts, elementMap }: {
  conflicts: ConflictInfo;
  elementMap: Record<string, Element>;
}) {
  const [open, setOpen] = useState(true);

  return (
    <div style={{ marginBottom: 20, border: '1px solid rgba(251,191,36,0.35)', borderRadius: 12, overflow: 'hidden', background: 'rgba(251,191,36,0.04)' }}>
      <div
        style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '12px 16px', cursor: 'pointer' }}
        onClick={() => setOpen((v) => !v)}
      >
        <span style={{ fontSize: 11, color: 'var(--text3)' }}>{open ? '▾' : '▸'}</span>
        <span style={{ fontSize: 16 }}>⚠️</span>
        <span style={{ fontWeight: 600, fontSize: 14, color: 'var(--warn)', flex: 1 }}>
          {conflicts.conflictCount} element{conflicts.conflictCount !== 1 ? 's' : ''} appear in multiple plans
        </span>
        <span style={{ fontSize: 12, color: 'var(--text3)' }}>
          These items can only be packed once — decide which plan they belong to.
        </span>
      </div>

      {open && (
        <div style={{ borderTop: '1px solid rgba(251,191,36,0.2)', padding: '10px 16px', display: 'flex', flexDirection: 'column', gap: 8 }}>
          {Object.entries(conflicts.elementConflicts).map(([eid, planNames]) => {
            const el = elementMap[eid];
            return (
              <div key={eid} style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '8px 10px', background: 'var(--bg3)', borderRadius: 8, border: '1px solid rgba(251,191,36,0.2)' }}>
                <span style={{ fontSize: 15 }}>{el?.isContainer ? '📦' : '🔹'}</span>
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: 14, fontWeight: 500 }}>{el?.name ?? `Unknown (${eid.slice(-6)})`}</div>
                  <div style={{ fontSize: 12, color: 'var(--text3)', marginTop: 2 }}>
                    Found in: {planNames.map((n, i) => (
                      <span key={n}>
                        <strong style={{ color: 'var(--text2)' }}>{n}</strong>
                        {i < planNames.length - 1 ? ' and ' : ''}
                      </span>
                    ))}
                  </div>
                </div>
                <span className="badge badge-warn" style={{ fontSize: 11 }}>conflict</span>
              </div>
            );
          })}
          <div style={{ fontSize: 12, color: 'var(--text3)', paddingTop: 4 }}>
            💡 To resolve: open one of the plans and remove the duplicate item, or move it to the correct plan.
          </div>
        </div>
      )}
    </div>
  );
}

// ── Plan section (read-only) ───────────────────────────────────────────────────

function PlanSection({ plan, elementMap, conflicts, index }: {
  plan: Plan; elementMap: Record<string, Element>;
  conflicts: ConflictInfo; index: number;
}) {
  const [collapsed, setCollapsed] = useState(false);
  const weight = calcTreeWeight(plan.tree, elementMap);

  // Count conflicts in this plan
  const planConflicts = plan.tree
    ? countConflictsInTree(plan.tree, conflicts.nodeConflictMap)
    : 0;

  return (
    <div className="card" style={{ padding: 0, overflow: 'hidden' }}>
      <div
        style={{ display: 'flex', alignItems: 'center', gap: 12, padding: '14px 18px', background: 'var(--bg2)', cursor: 'pointer', borderBottom: collapsed ? 'none' : '1px solid var(--border)' }}
        onClick={() => setCollapsed((v) => !v)}
      >
        <span style={{ fontSize: 11, color: 'var(--text3)', minWidth: 14 }}>{collapsed ? '▸' : '▾'}</span>
        <div style={{ fontSize: 16, fontWeight: 700, color: 'var(--accent)', fontFamily: 'var(--mono)', minWidth: 28 }}>
          #{index + 1}
        </div>
        <div style={{ flex: 1 }}>
          <div style={{ fontWeight: 700, fontSize: 16 }}>{plan.name}</div>
          {plan.description && <div style={{ fontSize: 13, color: 'var(--text3)', marginTop: 1 }}>{plan.description}</div>}
        </div>
        <div style={{ display: 'flex', gap: 8, alignItems: 'center' }}>
          {planConflicts > 0 && (
            <span className="badge badge-warn" style={{ fontSize: 11 }}>
              ⚠️ {planConflicts} conflict{planConflicts !== 1 ? 's' : ''}
            </span>
          )}
          <span style={{ fontSize: 13, color: 'var(--text2)' }}>{formatWeight(weight)}</span>
          <span className={`badge ${plan.status === 'active' ? 'badge-accent' : ''}`}>{plan.status}</span>
          <Link to={`/plans/${plan._id}`} className="btn btn-ghost btn-sm"
            onClick={(e) => e.stopPropagation()}>✏️ Edit</Link>
        </div>
      </div>

      {!collapsed && (
        <div style={{ padding: 16 }}>
          {plan.tree.length === 0 ? (
            <div style={{ color: 'var(--text3)', fontSize: 13, fontStyle: 'italic' }}>Empty plan</div>
          ) : (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
              {plan.tree.map((node) => (
                <ReadOnlyNode key={node._id} node={node} elementMap={elementMap}
                  conflicts={conflicts} depth={0} />
              ))}
            </div>
          )}
          <div style={{ marginTop: 12, paddingTop: 12, borderTop: '1px solid var(--border)', fontSize: 12, color: 'var(--text3)', display: 'flex', justifyContent: 'space-between' }}>
            <span>{countNodes(plan.tree)} item{countNodes(plan.tree) !== 1 ? 's' : ''}</span>
            <span>{formatWeight(weight)}</span>
          </div>
        </div>
      )}
    </div>
  );
}

function ReadOnlyNode({ node, elementMap, conflicts, depth }: {
  node: TreeNode; elementMap: Record<string, Element>;
  conflicts: ConflictInfo; depth: number;
}) {
  const [open, setOpen] = useState(true);
  const el = elementMap[node.elementId];
  const isContainer  = el?.isContainer ?? (node.children?.length > 0);
  const conflictPlan = conflicts.nodeConflictMap[node._id];
  const childWeight  = calcTreeWeight(node.children ?? [], elementMap);
  const ownWeight    = (el?.weight ?? 0) * (node.quantity ?? 1);

  return (
    <div style={{ marginLeft: depth * 18 }}>
      <div style={{
        display: 'flex', alignItems: 'center', gap: 8,
        padding: '7px 10px',
        background: conflictPlan ? 'rgba(251,191,36,0.06)' : depth === 0 ? 'var(--bg2)' : 'var(--bg3)',
        border: `1px solid ${conflictPlan ? 'rgba(251,191,36,0.3)' : 'var(--border)'}`,
        borderLeft: depth > 0 ? `2px solid rgba(110,231,183,${0.1 + depth * 0.08})` : undefined,
        borderRadius: 8, marginBottom: 4,
      }}>
        {isContainer ? (
          <span style={{ fontSize: 11, color: 'var(--text3)', cursor: 'pointer', minWidth: 14 }}
            onClick={() => setOpen((v) => !v)}>
            {open ? '▾' : '▸'}
          </span>
        ) : <span style={{ minWidth: 14 }} />}

        <span>{isContainer ? '📦' : '🔹'}</span>
        <span style={{ flex: 1, fontWeight: isContainer ? 600 : 400, fontSize: 14, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
          {node.name}
        </span>

        {(node.quantity ?? 1) > 1 && (
          <span style={{ fontSize: 11, color: 'var(--accent)', padding: '1px 6px', borderRadius: 6, background: 'rgba(110,231,183,0.1)', border: '1px solid rgba(110,231,183,0.2)', flexShrink: 0 }}>
            ×{node.quantity}
          </span>
        )}

        <span style={{ fontSize: 11, color: 'var(--text3)', flexShrink: 0 }}>
          {childWeight > 0 ? `${formatWeight(ownWeight + childWeight)} total` : formatWeight(ownWeight)}
        </span>

        {/* Conflict badge */}
        {conflictPlan && (
          <span style={{ fontSize: 10, padding: '2px 6px', borderRadius: 4, background: 'rgba(251,191,36,0.15)', color: 'var(--warn)', border: '1px solid rgba(251,191,36,0.3)', flexShrink: 0, whiteSpace: 'nowrap' }}>
            ⚠️ also in: {conflictPlan}
          </span>
        )}

        {el?.isReturnable && <span className="badge" style={{ fontSize: 10, flexShrink: 0 }}>↩</span>}
        {el?.isLastMinute && <span className="badge badge-warn" style={{ fontSize: 10, flexShrink: 0 }}>⚡</span>}
      </div>

      {open && node.children?.length > 0 && (
        <div style={{ marginBottom: 4 }}>
          {node.children.map((child) => (
            <ReadOnlyNode key={child._id} node={child} elementMap={elementMap}
              conflicts={conflicts} depth={depth + 1} />
          ))}
        </div>
      )}
    </div>
  );
}

// ── Helpers ────────────────────────────────────────────────────────────────────

function countNodes(nodes: TreeNode[]): number {
  let c = nodes.length;
  for (const n of nodes) c += countNodes(n.children ?? []);
  return c;
}

function countConflictsInTree(nodes: TreeNode[], nodeConflictMap: Record<string, string>): number {
  let c = 0;
  for (const n of nodes) {
    if (nodeConflictMap[n._id]) c++;
    if (n.children?.length) c += countConflictsInTree(n.children, nodeConflictMap);
  }
  return c;
}
